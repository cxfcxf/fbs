<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state - bright phosphor green -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer glow -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2600FF88" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <!-- Inner button -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00AA55" />
                    <stroke android:width="2dp" android:color="#00FF88" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#007744" />
            <stroke android:width="2dp" android:color="#00CC6A" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Default state - dark with subtle border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D140D" />
            <stroke android:width="1dp" android:color="#003319" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
